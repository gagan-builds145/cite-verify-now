# Copy these values into your shell or deployment environment.
# Server-to-server token; use the same value in Convex CITEVERIFY_ML_TOKEN.
CITEVERIFY_ML_TOKEN=replace-with-a-long-random-token

# Optional model directory overrides. Defaults come from models/registry.json.
# CITEVERIFY_RELEVANCE_MODEL_DIR=models/relevance/relevance-YYYYMMDD-HHMMSS
# CITEVERIFY_EVIDENCE_MODEL_DIR=models/evidence/evidence-YYYYMMDD-HHMMSS
# CITEVERIFY_RETRIEVAL_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional cross-encoder reranker. Leave unset on an 8 GB CPU laptop to reduce RAM.
# CITEVERIFY_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Set only for an isolated local demo. Never enable on a public deployment.
# CITEVERIFY_ML_ALLOW_UNAUTHENTICATED=1
